#!/usr/bin/env sh
# Gradle wrapper launcher. The wrapper jar is generated by Android Studio on first open
# (or by running `gradle wrapper --gradle-version 8.9` once a JDK 17 is available).
APP_HOME=$(cd "$(dirname "$0")" >/dev/null 2>&1 && pwd)
JAR="$APP_HOME/gradle/wrapper/gradle-wrapper.jar"
if [ ! -f "$JAR" ]; then
  echo "缺少 gradle/wrapper/gradle-wrapper.jar。"
  echo "请用 Android Studio 打开本工程（会自动补齐 wrapper），或先安装 JDK 17 后执行: gradle wrapper --gradle-version 8.9"
  exit 1
fi
if [ -n "$JAVA_HOME" ]; then
  JAVACMD="$JAVA_HOME/bin/java"
else
  JAVACMD=java
fi
exec "$JAVACMD" -classpath "$JAR" org.gradle.wrapper.GradleWrapperMain "$@"
